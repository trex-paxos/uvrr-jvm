<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>uvrr-jvm</groupId>
    <artifactId>uvrr-jvm</artifactId>
    <packaging>pom</packaging>
    <version>1.0-SNAPSHOT</version>
    <name>uvrr-jvm</name>
    <url>https://github.com/trex-paxos/uvrr-jvm</url>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <jacoco.version>0.8.15</jacoco.version>
        <!--
        The JSON API is a backport of the OpenJDK jdk-sandbox java.util.json feature,
        published as io.github.simbo1905.json:java.util.json: forty-four kilobytes, no
        transitive runtime dependencies, no module-info, so it loads on the plain
        classpath with no module flags.

        It is declared here for version alignment only. Nothing that ships depends on
        it: the dependency itself lives in uvrr-core's `compat` profile, at test scope,
        because the only JSON in this repository speaks the Maelstrom wire protocol
        and the Hurl suite's HTTP endpoints, and all of that is integration-test code.
        The release artifacts - uvrr-lib, uvrr-paxe, uvrr-core - carry no JSON.
        -->
        <json.version>2026.08.31</json.version>
    </properties>
    <description>uVRR: viewstamped replication for strong consistency in cluster replication on the JVM,
    following Viewstamped Replication Revisited (Liskov, Cowling et al) with eras, weighted quorums
    and incarnation reincarnation.
    </description>
    <modules>
        <module>uvrr-lib</module>
        <module>uvrr-paxe</module>
        <module>uvrr-core</module>
    </modules>
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.11.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.26.3</version>
            <scope>test</scope>
        </dependency>
        <!--
        The JetBrains annotations are used to provide @TestOnly and @NotNull annotations.
        The @TestOnly is code smell that functional programming should help to remove.
        These annotations are build time only.
        -->
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>26.0.2</version>
            <scope>provided</scope>
        </dependency>
        <!--
        @With is used to polyfill 'with' until JEP 468 removes the need for it.
        These annotations are build time only.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.38</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.simbo1905.json</groupId>
                <artifactId>java.util.json</artifactId>
                <version>${json.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <compilerArgs>
                        <arg>-Werror</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.38</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
